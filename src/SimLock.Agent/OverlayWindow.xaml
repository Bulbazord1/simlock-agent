<Window x:Class="SimLock.Agent.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimLock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        Width="400" Height="300"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="Big" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="QrCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Banner" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ───────── Reposo: fondo oscuro, bloque chico que cambia de lugar cada minuto ───────── -->
        <Canvas x:Name="RestPanel" Visibility="Collapsed" Background="Black" ClipToBounds="True">
            <Border x:Name="RestCard" Padding="8">
                <StackPanel HorizontalAlignment="Center">
                    <Image x:Name="RestLogo" MaxHeight="56" MaxWidth="220" Stretch="Uniform" Opacity="0.55"
                           HorizontalAlignment="Center" Margin="0,0,0,14" Visibility="Collapsed" />
                    <TextBlock x:Name="RestClock" Style="{StaticResource Big}" FontSize="96" FontWeight="Light"
                               Foreground="#66FFFFFF" TextAlignment="Center" />
                    <TextBlock x:Name="RestBay" FontSize="22" Foreground="#59FFFFFF" TextAlignment="Center" Margin="0,4,0,0" />
                    <Border x:Name="RestQrCard" Style="{StaticResource QrCard}" Margin="0,22,0,0" Padding="10" Visibility="Collapsed" Opacity="0.92">
                        <StackPanel>
                            <Image x:Name="RestQr" Width="150" Height="150" RenderOptions.EdgeMode="Aliased" />
                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#FF1A1A1A" TextAlignment="Center" Margin="0,6,0,0"
                                       Text="¿Seguís jugando? Extendé tu turno" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="RestMessage" FontSize="18" Foreground="#99F2C94C" TextAlignment="Center" Margin="0,14,0,0"
                               MaxWidth="420" Visibility="Collapsed" />
                    <TextBlock x:Name="RestOffline" FontSize="14" Foreground="#59FFFFFF" TextAlignment="Center" Margin="0,10,0,0"
                               Visibility="Collapsed" Text="Sin conexión" />
                </StackPanel>
            </Border>
        </Canvas>

        <!-- ───────── Pantalla completa: espera / por empezar / check-in / terminado / sin vincular ───────── -->
        <Border x:Name="FullPanel" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="FullMessage" Grid.Row="0" Style="{StaticResource Banner}" Margin="0,32,0,0"
                        Background="#FFF2C94C" Visibility="Collapsed">
                    <TextBlock x:Name="FullMessageText" FontSize="26" FontWeight="SemiBold" Foreground="#FF1A1A1A" TextAlignment="Center" />
                </Border>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="1100">
                    <Image x:Name="FullLogo" MaxHeight="140" MaxWidth="420" Margin="0,0,0,32" Stretch="Uniform"
                           HorizontalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock x:Name="FullTitle" FontSize="72" FontWeight="Bold" TextAlignment="Center" />
                    <TextBlock x:Name="FullSubtitle" FontSize="32" Margin="0,16,0,0" TextAlignment="Center" Opacity="0.9" />
                    <Border x:Name="FullQrCard" Style="{StaticResource QrCard}" Margin="0,40,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <Image x:Name="FullQr" Width="320" Height="320" RenderOptions.EdgeMode="Aliased" />
                            <TextBlock x:Name="FullQrCaption" FontSize="22" FontWeight="SemiBold" Foreground="#FF1A1A1A"
                                       TextAlignment="Center" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="FullPending" Style="{StaticResource Banner}" Margin="0,32,0,0" Background="#FFFFB020" Visibility="Collapsed">
                        <TextBlock Text="Pago pendiente — pasá por recepción" FontSize="26" FontWeight="SemiBold" Foreground="#FF1A1A1A" />
                    </Border>
                </StackPanel>

                <DockPanel Grid.Row="2" Margin="32,0,32,24" LastChildFill="False">
                    <TextBlock x:Name="FullOffline" DockPanel.Dock="Left" FontSize="18" Opacity="0.85" Visibility="Collapsed"
                               Text="● Sin conexión — mostrando el último estado conocido" />
                    <TextBlock x:Name="FullFooter" DockPanel.Dock="Right" FontSize="18" Opacity="0.7" />
                </DockPanel>
            </Grid>
        </Border>

        <!-- ───────── Reloj discreto mientras se juega ───────── -->
        <Border x:Name="PillPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                CornerRadius="18" Background="#D9101418" Padding="20,10" MinWidth="200">
            <StackPanel>
                <TextBlock x:Name="PillTime" Style="{StaticResource Big}" FontSize="34" Foreground="White" TextAlignment="Center" />
                <TextBlock x:Name="PillMessage" FontSize="16" Foreground="#FFF2C94C" TextAlignment="Center" MaxWidth="320" Visibility="Collapsed" />
                <TextBlock x:Name="PillPending" FontSize="15" Foreground="#FFFFB020" TextAlignment="Center" Visibility="Collapsed"
                           Text="Pago pendiente — pasá por recepción" />
                <TextBlock x:Name="PillOffline" FontSize="13" Foreground="#FFBBBBBB" TextAlignment="Center" Visibility="Collapsed"
                           Text="Sin conexión" />
            </StackPanel>
        </Border>

        <!-- ───────── Últimos minutos: tarjeta en la esquina ───────── -->
        <Border x:Name="WarnPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                CornerRadius="22" Padding="24" Width="360">
            <StackPanel>
                <TextBlock x:Name="WarnLabel" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Text="Quedan" />
                <TextBlock x:Name="WarnTime" Style="{StaticResource Big}" FontSize="64" TextAlignment="Center" />
                <TextBlock x:Name="WarnEnds" FontSize="18" TextAlignment="Center" Opacity="0.85" />
                <Border x:Name="WarnQrCard" Style="{StaticResource QrCard}" Margin="0,18,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <Image x:Name="WarnQr" Width="200" Height="200" RenderOptions.EdgeMode="Aliased" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#FF1A1A1A" TextAlignment="Center" Margin="0,8,0,0"
                                   Text="Escaneá para extender tu turno" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="WarnMessage" FontSize="18" Foreground="#FFF2C94C" TextAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="WarnPending" FontSize="17" Foreground="#FFFFB020" TextAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"
                           Text="Pago pendiente — pasá por recepción" />
                <TextBlock x:Name="WarnOffline" FontSize="14" TextAlignment="Center" Margin="0,8,0,0" Opacity="0.8" Visibility="Collapsed"
                           Text="Sin conexión" />
            </StackPanel>
        </Border>

        <!-- ───────── Aviso al cruzar un umbral (unos segundos, centrado) ───────── -->
        <Border x:Name="ToastPanel" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                CornerRadius="28" Padding="40,32" Width="760">
            <StackPanel>
                <TextBlock x:Name="ToastTitle" Style="{StaticResource Big}" FontSize="72" TextAlignment="Center" />
                <TextBlock x:Name="ToastSubtitle" FontSize="28" TextAlignment="Center" Margin="0,8,0,0" Opacity="0.9" />
                <Border x:Name="ToastQrCard" Style="{StaticResource QrCard}" Margin="0,24,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <Image x:Name="ToastQr" Width="240" Height="240" RenderOptions.EdgeMode="Aliased" />
                        <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#FF1A1A1A" TextAlignment="Center" Margin="0,8,0,0"
                                   Text="Escaneá para extender tu turno" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
